{
  "$defs": {
    "BootstrapRequest": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_token": {
          "description": "The one-time launcher secret exchanged for a local browser session.",
          "type": "string"
        }
      },
      "required": [
        "bootstrap_token"
      ],
      "type": "object"
    },
    "BootstrapResponse": {
      "additionalProperties": false,
      "properties": {
        "csrf_token": {
          "description": "The in-memory CSRF value bound to the issued browser session.",
          "type": "string"
        }
      },
      "required": [
        "csrf_token"
      ],
      "type": "object"
    },
    "MetadataResponse": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "description": "The versioned browser boundary exposed by the service.",
          "type": "string"
        },
        "contract_version": {
          "description": "The semver revision of this OpenAPI contract.",
          "type": "string"
        },
        "product": {
          "description": "The product name that owns this local API.",
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "contract_version",
        "product"
      ],
      "type": "object"
    },
    "SelectionRequest": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "description": "The CLI Alias of the Ready Identity Profile to select.",
          "type": "string"
        }
      },
      "required": [
        "alias"
      ],
      "type": "object"
    },
    "SelectionResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "description": "The immutable identifier of the Selected Profile.",
          "type": "string"
        },
        "alias": {
          "description": "The Selected Profile CLI Alias.",
          "type": "string"
        },
        "display_name": {
          "description": "The Selected Profile display label.",
          "type": "string"
        },
        "warning": {
          "description": "A safe warning when a running Launch Profile differs, otherwise empty.",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "alias",
        "display_name",
        "warning"
      ],
      "type": "object"
    },
    "UsageRefreshRequest": {
      "additionalProperties": false,
      "properties": {
        "alias": {"description": "The CLI Alias of the Ready Identity Profile to refresh.", "type": "string"}
      },
      "required": ["alias"],
      "type": "object"
    },
    "UsageErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "code": {"description": "Stable machine-readable error identifier.", "type": "string"},
        "message": {"description": "Safe user-facing error message.", "type": "string"}
      },
      "required": ["code", "message"],
      "type": "object"
    },
    "UsageMetricAvailability": {
      "additionalProperties": false,
      "properties": {
        "metric_availability_id": {"type": "string"},
        "metric_key": {"type": "string"},
        "state": {"type": "string"},
        "checked_at": {"type": "string"},
        "provenance": {"type": "string"}
      },
      "required": ["metric_availability_id", "metric_key", "state", "checked_at", "provenance"],
      "type": "object"
    },
    "UsageObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {"type": "string"},
        "metric_key": {"type": "string"},
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "value_kind": {"type": "string"},
        "source_class": {"type": "string"},
        "scope": {"type": "string"},
        "aggregation": {"type": "string"},
        "observed_at": {"type": "string"},
        "window_start": {"type": "string"},
        "window_end": {"type": "string"},
        "provenance": {"type": "string"},
        "freshness": {"type": "string"},
        "availability": {"type": "string"}
      },
      "required": ["observation_id", "metric_key", "value", "unit", "value_kind", "source_class", "scope", "aggregation", "observed_at", "window_start", "window_end", "provenance", "freshness", "availability"],
      "type": "object"
    },
    "UsageSnapshotResponse": {
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {"type": "string"},
        "profile_id": {"type": "string"},
        "alias": {"type": "string"},
        "source": {"type": "string"},
        "source_version": {"type": "string"},
        "captured_at": {"type": "string"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/UsageObservation"}},
        "availability": {"type": "array", "items": {"$ref": "#/$defs/UsageMetricAvailability"}}
      },
      "required": ["snapshot_id", "profile_id", "alias", "source", "source_version", "captured_at", "observations", "availability"],
      "type": "object"
    }
  },
  "info": {
    "description": "The versioned, non-product browser boundary for CodexFolio.",
    "title": "CodexFolio Local API",
    "version": "0.0.1-alpha"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/bootstrap": {
      "post": {
        "operationId": "exchangeBootstrap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/$defs/BootstrapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/BootstrapResponse"
                }
              }
            },
            "description": "Exchanges a one-time launcher secret for a short-lived local session."
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "getMetadata",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/MetadataResponse"
                }
              }
            },
            "description": "Returns non-product API metadata."
          }
        }
      }
    },
    "/api/v1/selection": {
      "get": {
        "operationId": "getSelection",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/SelectionResponse"
                }
              }
            },
            "description": "Returns the current Selected Profile."
          }
        }
      },
      "put": {
        "operationId": "setSelection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/$defs/SelectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/SelectionResponse"
                }
              }
            },
            "description": "Persists one Ready Identity Profile as Selected Profile."
          }
        }
      }
    },
    "/api/v1/usage/refresh": {
      "post": {
        "operationId": "refreshUsage",
        "requestBody": {
          "content": {"application/json": {"schema": {"$ref": "#/$defs/UsageRefreshRequest"}}},
          "required": true
        },
        "responses": {
          "200": {
            "content": {"application/json": {"schema": {"$ref": "#/$defs/UsageSnapshotResponse"}}},
            "description": "Collects and persists one normalized Usage Snapshot."
          },
          "default": {
            "content": {"application/json": {"schema": {"$ref": "#/$defs/UsageErrorResponse"}}},
            "description": "Returns a stable, safe error identifier when refresh fails."
          }
        }
      }
    }
  },
  "x-codex-folio-api-version": "v1"
}
