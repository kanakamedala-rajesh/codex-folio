# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Project build output and local JavaScript dependencies
/build/
/web/dist/
/web/node_modules/
*.tsbuildinfo

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Local authentication, profile homes, and generated application state.
# Keep the versioned .codex/agents project configuration visible to Git.
.env.*
!.env.example
!.env.sample
!.env.template
/.codex/auth.json
/.codex/sessions/
/.codex/archived_sessions/
/.codex/history.jsonl
/.codex/log/
/.codex/logs/
/.codex/*.sqlite*
/.codex/*.db*
/.codex-home/
/.codex-folio/
/identity-homes/
/local-state/

# Private review output belongs outside the repository even when ignored.
/publication-audit/
/gitleaks-report.*
/diagnostic-bundle*

# Data files should be explicitly reviewed before force-adding synthetic fixtures.
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
